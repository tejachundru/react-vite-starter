{
  "name": "vite-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bootstrap": "git init && npx husky init && npx playwright install && shx rm .husky/pre-commit",
    "format": "prettier src/**/*.{ts,tsx} --write",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "test": "vitest run src/ && playwright test",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "commitlint": "commitlint --edit",
    "commitizen": "exec < /dev/tty && git cz --hook || true",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "analyze": "vite build --mode analyze",
    "clean": "shx rm -rf dist node_modules/.vite coverage storybook-static",
    "docker:build": "docker build -t react-vite-starter -f ./Dockerfile .",
    "docker:run": "docker run -p 8080:80 react-vite-starter"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^1.54.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "shx": "^0.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "react-i18next": "^17.0.16",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
